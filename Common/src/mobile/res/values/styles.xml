<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSwipeToDismiss">false</item>

        <item name="android:textViewStyle">@style/MyTextViewStyle</item>
        <item name="android:textAppearanceButton">@style/textAppearanceButton</item>

        <item name="android:spinnerDropDownItemStyle">@style/MySpinnerDropDownItemStyle</item>
        <item name="android:checkboxStyle">@style/MyCheckBoxStyle</item>

        <item name="android:radioButtonStyle">@style/MyRadioButtonStyle</item>


        <item name="themedButtonBackground">@drawable/button_rectangle</item>
        <item name="colorButtonBackground">#1E1E1E</item>
        <item name="buttonCornerRadius">10dp</item>
        <item name="colorButtonText">?android:attr/textColorPrimary</item>
        <item name="colorSpinnerDropdownText">#E0E0E0</item>
        <item name="colorDialogBackground">?android:attr/windowBackground</item>
        <item name="colorDialogBorder">#ecf018</item>
        <item name="colorHelpBackground">?android:attr/windowBackground</item>
        <item name="colorHelpBorder">#4c34eb</item>
        <item name="colorMirrorConnection">@color/yellow</item>

    </style>


    <style name="MySpinnerDropDownItemStyle" parent="android:Widget.DropDownItem.Spinner">
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textColor">?attr/colorSpinnerDropdownText</item>
    </style>

    <style name="textAppearanceButton" parent="@android:style/TextAppearance.Material.Widget.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorButtonText</item>
    </style>

    <style name="textAppearanceButtonDark" parent="@android:style/TextAppearance.Material.Widget.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#07120A</item>
    </style>

    <style name="MyTextViewStyle" parent="android:Widget.TextView">
        <item name="android:paddingRight">20dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="MyCheckBoxStyle" parent="android:Widget.CompoundButton.CheckBox">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="MyRadioButtonStyle" parent="android:Widget.CompoundButton.RadioButton">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="mybuttonstyle" parent="@android:style/Widget.Button">

        <item name="android:background">?attr/themedButtonBackground</item>

        <item name="android:textColor">?attr/colorButtonText</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MyDarkAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textViewStyle">@style/MyDialogTextViewStyle</item>
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button.ButtonBar.AlertDialog</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.AppCompat.Button</item>
    </style>

    <style name="MyLightAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textViewStyle">@style/MyDialogTextViewStyle</item>
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button.ButtonBar.AlertDialog</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.AppCompat.Button</item>
    </style>

    <style name="MyDialogTextViewStyle" parent="android:Widget.TextView">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- ========================================= -->
    <!-- LIGHT THEMES                              -->
    <!-- ========================================= -->

</resources>
