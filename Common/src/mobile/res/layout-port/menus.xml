<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait variant of layout/menus.xml: same ids, two readable columns. -->
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menusview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="3"
    android:rowCount="10"
    android:paddingHorizontal="8dp"
    android:textAlignment="textStart"
    >
    <CheckBox
        android:id="@+id/menus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:checked="true"
        android:textSize="16sp"
        android:text="@string/menus" />
    <Button
        android:id="@+id/sensor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/sensor" />
    <Button
        android:id="@+id/settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/settings" />
    <CheckBox
        android:id="@+id/stream"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/streamname" />
    <CheckBox
        android:id="@+id/calibratedstream"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_column="2"
        android:layout_rowWeight="1"
        android:text="" />
    <Button
        android:id="@+id/mirror"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/mirror" />
    <Button
        android:id="@+id/export"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/export" />
    <CheckBox
        android:id="@+id/amounts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/amountsname" />
    <Button
        android:id="@+id/newamount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/new_amount" />
    <Button
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="6"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/list" />
    <CheckBox
        android:id="@+id/glucosefloat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/floatname" />
    <Button
        android:id="@+id/statistics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="7"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/statistics" />
    <Button
        android:id="@+id/watch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/watches" />
    <Button
        android:id="@+id/now"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="7"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/now" />
    <Button
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="5"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/search" />
    <Button
        android:id="@+id/date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="6"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/date" />
    <Button
        android:id="@+id/close"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="4"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/closename" />
    <Button
        android:id="@+id/dayback"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="8"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/day_back" />
    <Button
        android:id="@+id/daylater"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="8"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/day_later" />
    <Button
        android:id="@+id/weekback"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="9"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/week_back" />
    <Button
        android:id="@+id/weeklater"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_row="9"
        android:layout_column="1"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_marginHorizontal="4dp"
        android:textSize="16sp"
        android:text="@string/week_later" />
</GridLayout>
